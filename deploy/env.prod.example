# Housetel — production environment (docker-compose.prod.yml). Copy it to .env.prod on the server, fill it in and
# keep it out of git (it holds every secret of the installation). Guide: docs/deploy.md.
#
#   cp deploy/env.prod.example .env.prod && chmod 600 .env.prod
#   make prod-build && make prod-up
#
# Values below marked "change-me" are placeholders: the stack refuses to start with an empty secret key or Fernet
# key, but it cannot tell a placeholder from a real password, so replace all of them.

# --- Required ------------------------------------------------------------------------------------------------------
# Public URL of the app (https in production). Links in e-mails, payment return URLs, the guest portal and the
# embeddable widget are built from it; its host is also the default DJANGO_ALLOWED_HOSTS.
FRONTEND_URL=https://app.example.com
# Secret key: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me-with-a-long-random-string
# Encrypts the integration secrets at rest. Generate it once and back it up with the database (without it the
# stored Wompi/Factus/WhatsApp credentials cannot be decrypted):
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=change-me-with-a-fernet-key
# PostgreSQL of the compose stack (use letters and digits: it goes inside DATABASE_URL).
POSTGRES_PASSWORD=change-me-db-password

# --- Web ------------------------------------------------------------------------------------------------------------
# Host port nginx listens on (put TLS in front of it). Default 8080.
HOUSETEL_HTTP_PORT=8080
# Optional. Comma-separated hosts Django answers (default: the hosts of FRONTEND_URL and PUBLIC_BASE_URL).
# DJANGO_ALLOWED_HOSTS=app.example.com
# Optional. Origins allowed for CSRF (default: the origin of FRONTEND_URL, plus PUBLIC_BASE_URL's).
# CSRF_TRUSTED_ORIGINS=https://app.example.com
# Proxies that append to X-Forwarded-For in front of gunicorn: nginx = 1; add 1 per load balancer/CDN in front of
# nginx (per-IP rate limits such as the login throttle depend on it).
NUM_PROXIES=1
# Keep 1 behind HTTPS. Only for trying this stack over plain http (e.g. http://localhost:8080): set it to 0.
DJANGO_SECURE_SSL_REDIRECT=1
# Optional. Where webhooks and guest links point when it is not FRONTEND_URL (e.g. a tunnel while testing).
# PUBLIC_BASE_URL=https://app.example.com
# gunicorn processes and threads per process.
GUNICORN_WORKERS=3
GUNICORN_THREADS=2
CELERY_CONCURRENCY=2
# /django-admin/ (0 = does not exist). When 1, only signed-in staff users reach it (sign in at /login first).
ADMIN_ENABLED=0
# Extra Content-Security-Policy sources for images (e.g. the S3/CDN domain of public photos) and API calls.
# NGINX_CSP_IMG_SRC=https://media.example.com
# NGINX_CSP_CONNECT_SRC=

# --- Simulations ----------------------------------------------------------------------------------------------------
# Off in production: no simulated payment gateway, no OTA/WhatsApp simulators, every integration starts in real
# mode (disabled until configured). 1 = demo server with simulations.
HOUSETEL_ALLOW_SIMULATIONS=0

# --- Support channels shown in the app ("Help and support", error pages) -----------------------------------------
# WhatsApp number in international format, e.g. +57 300 123 4567 (empty = not offered).
SUPPORT_WHATSAPP=
SUPPORT_EMAIL=soporte@example.com
# Help center / guides (empty = not offered).
SUPPORT_DOCS_URL=

# --- E-mail (transactional SMTP with SPF/DKIM for the sender domain: docs/integraciones-reales.md) ---------------
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=change-me
EMAIL_HOST_PASSWORD=change-me
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=Housetel <no-reply@example.com>

# --- AI (optional) ----------------------------------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5

# --- Platform billing: Housetel's own Wompi account (optional) -------------------------------------------------------
# Without these keys the saas_billing integration is not live: keep the subscriptions in trial/active from /admin.
WOMPI_PLATFORM_ENV=production
WOMPI_PLATFORM_PUBLIC_KEY=
WOMPI_PLATFORM_PRIVATE_KEY=
WOMPI_PLATFORM_INTEGRITY_SECRET=
WOMPI_PLATFORM_EVENTS_SECRET=

# --- Monitoring (optional) --------------------------------------------------------------------------------------------
# Sentry: errors of the API, the worker and beat. Traces off by default (0.0–1.0).
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
# SENTRY_RELEASE=housetel@2026.09.28
LOG_LEVEL=INFO

# --- Object storage (optional; default: Docker volumes on this server) -------------------------------------------
# S3-compatible (AWS S3, DigitalOcean Spaces, Cloudflare R2, MinIO…). Public photos go to AWS_STORAGE_BUCKET_NAME
# (readable by anyone: give the bucket a public-read policy or a CDN), private files to
# AWS_PRIVATE_STORAGE_BUCKET_NAME (never public; signed 5-minute URLs are only used internally).
# AWS_STORAGE_BUCKET_NAME=housetel-media
# AWS_PRIVATE_STORAGE_BUCKET_NAME=housetel-private
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_REGION_NAME=us-east-1
# AWS_S3_ENDPOINT_URL=https://nyc3.digitaloceanspaces.com
# AWS_S3_CUSTOM_DOMAIN=media.example.com

# --- Backups (scripts/backup.sh, `make backup`) ------------------------------------------------------------------------
BACKUP_DIR=backups
BACKUP_RETENTION_DAYS=14
# Optional off-site copy: s3://bucket/prefix (uses the aws CLI, or the amazon/aws-cli image, with the AWS_* keys above
# or BACKUP_AWS_* below).
# BACKUP_S3_URI=s3://housetel-backups/prod
# BACKUP_AWS_ACCESS_KEY_ID=
# BACKUP_AWS_SECRET_ACCESS_KEY=
# BACKUP_AWS_DEFAULT_REGION=us-east-1
# BACKUP_S3_ENDPOINT_URL=
