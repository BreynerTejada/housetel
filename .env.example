# Housetel — environment variables (development).
# Copy to `.env` (never commit `.env`) and fill in what you need. Everything works without external
# credentials: in development every integration defaults to its `simulated` mode.
# Production uses its own file: deploy/env.prod.example → .env.prod (guide: docs/deploy.md).

# --- Environment ---------------------------------------------------------------------------------------
# development (default) | production. Production refuses to start without DJANGO_SECRET_KEY, FERNET_KEY and
# FRONTEND_URL or with DJANGO_DEBUG=1, and turns on HTTPS-only cookies, HSTS, JSON logs, a locked-down admin and
# staff-only API docs.
# DJANGO_ENV=development
# Simulations (simulated payment gateway, OTA/WhatsApp simulators, simulated providers). Unset: on in development,
# off in production. 0 = try the real providers locally (docs/integraciones-reales.md); 1 = demo server in production.
# HOUSETEL_ALLOW_SIMULATIONS=0

# --- Django ------------------------------------------------------------------------------------------
# Secret key for sessions/signing. Generate one: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
# 1 = development mode (debug pages, browsable API). Use 0 in production.
DJANGO_DEBUG=1
# Optional. Comma-separated hosts; defaults to * in development.
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Optional. Comma-separated origins allowed to send CSRF-protected requests (defaults to the Vite dev server).
# CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional. Log level of the backend processes.
# LOG_LEVEL=INFO
# Optional. Login attempts per minute and IP (DRF rate). Default 30/min with DJANGO_DEBUG=1 (every browser
# reaches Django through the Vite proxy with the same IP) and 10/min otherwise.
# LOGIN_THROTTLE_RATE=10/min
# Optional. Folder for guest identity documents (ID photos, passports, signatures). It must be outside anything
# a web server publishes; defaults to backend/media-private/ (never served under /media/).
# PRIVATE_MEDIA_ROOT=/srv/housetel/private-media

# Public URL of the frontend (used in e-mails, payment return URLs and guest-portal links).
FRONTEND_URL=http://localhost:5173
# Optional. URL where the outside world reaches this installation: webhooks (Wompi, WhatsApp) and the links guests
# receive. For real webhooks in development open a tunnel and paste its URL here, then restart backend/worker/beat:
#   cloudflared tunnel --url http://localhost:5173 --http-host-header localhost:5173
# PUBLIC_BASE_URL=https://example.trycloudflare.com

# --- Support channels shown in the app ("Help and support" in the user menu, error pages) -------------------
# WhatsApp in international format (empty = not offered), e-mail (default soporte@housetel.co) and a help-center URL.
# SUPPORT_WHATSAPP=+57 300 123 4567
# SUPPORT_EMAIL=soporte@housetel.co
# SUPPORT_DOCS_URL=https://ayuda.housetel.co

# Fernet key that encrypts integration secrets at rest.
# Generate one: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# --- AI ----------------------------------------------------------------------------------------------
# Google Gemini API key. With a key the LLM integration starts in `real` mode (falls back to simulated
# on quota/errors); without it everything uses the simulated LLM.
GEMINI_API_KEY=
# Gemini model used by the copilot, chatbot, onboarding and revenue explanations.
GEMINI_MODEL=gemini-3.5-flash
# Optional. Anthropic API key, for properties that choose Claude as their LLM provider.
ANTHROPIC_API_KEY=
# Claude model used when a property selects the Claude provider.
CLAUDE_MODEL=claude-sonnet-5

# --- Platform billing (SaaS subscriptions via Wompi) --------------------------------------------------
# Optional. Housetel's own Wompi account (only for the `real` mode of the saas_billing integration).
WOMPI_PLATFORM_PUBLIC_KEY=
# Optional. Wompi private key (server-side API calls).
WOMPI_PLATFORM_PRIVATE_KEY=
# Optional. Wompi integrity secret (checkout signature).
WOMPI_PLATFORM_INTEGRITY_SECRET=
# Optional. Wompi events secret (webhook checksum).
WOMPI_PLATFORM_EVENTS_SECRET=
# Wompi environment: sandbox | production.
WOMPI_PLATFORM_ENV=sandbox

# --- Set by docker-compose (only needed when running the backend outside Docker) ----------------------
# DATABASE_URL=postgres://housetel:housetel@localhost:5432/housetel
# REDIS_URL=redis://localhost:6379/0
# EMAIL_HOST=localhost
# EMAIL_PORT=1025
# Optional SMTP credentials/TLS for a real mail server (Mailpit needs none).
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=0
# EMAIL_USE_SSL=0
# Sender of the platform e-mails (its domain must pass SPF/DKIM in production).
# DEFAULT_FROM_EMAIL=Housetel <no-reply@housetel.co>
# Test database name, so parallel test runs do not collide (docker compose run -e TEST_DB_NAME=test_x ...).
# TEST_DB_NAME=test_housetel

# --- Production knobs (also documented in deploy/env.prod.example) --------------------------------------
# Proxies appending to X-Forwarded-For in front of Django (nginx = 1): per-IP throttles use the real client IP.
# NUM_PROXIES=1
# /django-admin/ (default: on in development; off in production, and then staff-only when turned on).
# ADMIN_ENABLED=1
# /api/schema/ and /api/docs/ without login (default: yes in development, no in production).
# API_DOCS_PUBLIC=1
# Log format: console (development default) | json (production default).
# LOG_FORMAT=console
# Optional Sentry error tracking (API, worker and beat).
# SENTRY_DSN=
# Optional S3-compatible storage: public photos in AWS_STORAGE_BUCKET_NAME, private files in
# AWS_PRIVATE_STORAGE_BUCKET_NAME (see docs/deploy.md → Almacenamiento de archivos).
# AWS_STORAGE_BUCKET_NAME=
# AWS_PRIVATE_STORAGE_BUCKET_NAME=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_REGION_NAME=
# AWS_S3_ENDPOINT_URL=

# --- Docker ------------------------------------------------------------------------------------------
# Optional. uid:gid the backend containers run as, so files they create stay editable (default 1000:1000).
# HOST_UID=1000
# HOST_GID=1000
